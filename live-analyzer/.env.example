# Kite API Configuration
KITE_API_KEY=your_kite_api_key
KITE_API_SECRET=your_kite_api_secret

# Cryptography (Generate a Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=your_fernet_encryption_key_here

# App Security
# Hashed password for application access. Generate using bcrypt or similar.
APP_PASSWORD_HASH=your_bcrypt_hashed_password_here

# Server settings
BIND_IP=127.0.0.1
PORT=8000
DATABASE_URL=sqlite:///./portfolio.db

# Frontend settings
FRONTEND_URL=http://localhost:5173
